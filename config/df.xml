<?xml version="1.0" encoding="UTF-8"?>
<!-- DfApp configuration — 4-element PlutoSDR array -->
<df_config>

  <scanner_id>df-0</scanner_id>

  <amqp>
    <url>amqp://localhost:5672</url>
    <username>sdr_ctrl</username>
    <password>sdr_hw_test</password>
    <detections_topic>rf.detections</detections_topic>
    <df_results_topic>rf.df_results</df_results_topic>
  </amqp>

  <database>
    <host>localhost</host><port>5432</port><name>sdr_scanner</name>
    <user>sdr</user><password>sdr_hw_test</password>
  </database>

  <!--
    Antenna positions in metres, ENU frame (x=East, y=North, z=Up).
    Measure from any fixed reference point on your antenna mast / vehicle roof.
    scanner_id must match the scanner_id in each AcquisitionApp's scanner.xml.

    Example: 5-element uniform circular array (UCA) with 2 m radius:
      Element 0: centre   (reference)
      Elements 1-4: on a circle at 72° intervals
  -->
  <array>
    <!--
      L-shaped 4-element array, λ/2 spacing at 300 MHz (~50 cm).
      UPDATE these values once you physically measure your antenna positions.
      x = East (m), y = North (m) from antenna 0 (reference).

      Suggested physical layout:
        [1]
         |  0.50 m
        [0]---[2]---[3]
              0.50m  1.00m
    -->
    <antenna scanner_id="scanner-0" x="0.00" y="0.00" z="0.00"/>
    <antenna scanner_id="scanner-1" x="0.00" y="0.50" z="0.00"/>
    <antenna scanner_id="scanner-2" x="0.50" y="0.00" z="0.00"/>
    <antenna scanner_id="scanner-3" x="1.00" y="0.00" z="0.00"/>
  </array>

  <df>
    <!-- MUSIC: Multiple Signal Classification — optimal for coherent arrays -->
    <algorithm>MUSIC</algorithm>

    <!-- Collect snapshots within this window before computing.
         All 5 PlutoSDRs should report the same signal within one sweep pass. -->
    <aggregation_window_ms>5000</aggregation_window_ms>

    <!-- Minimum antennas required for a valid bearing estimate.
         3 is a practical minimum; 5 gives the best accuracy. -->
    <min_elements>3</min_elements>

    <!-- Angular resolution of the MUSIC sweep. 0.5° is a good default.
         Finer steps (0.1°) improve accuracy but add ~5× compute. -->
    <angle_step_deg>0.5</angle_step_deg>

    <!-- Discard snapshots from antennas with SNR below this threshold (dB).
         Low-SNR elements degrade the covariance estimate. -->
    <snr_threshold_db>3.0</snr_threshold_db>
  </df>

</df_config>
